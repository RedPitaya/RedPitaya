################################################################################
# versioning system
################################################################################

SHELL := /bin/bash
BUILD_NUMBER ?= dev
# Required OS version
LINUX_VER ?= 3.03

# GITLAB,GITHUB,LOCAL
GIT_MODE ?= GITHUB
GITLAB_TOKEN ?= NONE
GIT_LOCAL_PATH ?=NONE

SDR_ZIP ?= SDR-bundle-82-cbecbdd4.zip

CPU_CORES = $(shell ./get_cpu_ram.sh)

REVISION ?= $(shell git rev-parse --short HEAD)
VERSION = $(LINUX_VER)-$(BUILD_NUMBER)
export BUILD_NUMBER
export REVISION
export VERSION


################################################################################
# targets
################################################################################

all: u-boot linux boot

################################################################################
#
################################################################################

# check if download cache directory is available
DL          ?= dl
TMP          = tmp
INSTALL_DIR  = build

$(DL):
	mkdir -p $@

$(TMP):
	mkdir -p $@

$(INSTALL_DIR):
	mkdir -p $@

################################################################################
# X86 build (Vivado FPGA synthesis, FSBL, U-Boot, Linux kernel)
################################################################################

UBOOT_TAG      = redpitaya-v2026.1
LINUX_TAG      = branch-redpitaya-v2026-dev

UBOOT_DIR     = $(TMP)/u-boot-xlnx-$(UBOOT_TAG)
LINUX_DIR     = $(TMP)/linux-xlnx-$(LINUX_TAG)

UBOOT_TAR     = $(DL)/u-boot-xlnx-$(UBOOT_TAG).tar.gz
LINUX_TAR     = $(DL)/linux-xlnx-$(LINUX_TAG).tar.gz

# it is possible to use an alternative download location (local) by setting environment variables
UBOOT_URL     ?= https://github.com/RedPitaya/u-boot-xlnx/archive/$(UBOOT_TAG).tar.gz

LINUX_URL     ?= https://github.com/RedPitaya/linux-xlnx/archive/$(LINUX_TAG).tar.gz
DTREE_URL     ?= https://github.com/Xilinx/device-tree-xlnx/archive/$(DTREE_TAG).tar.gz

LINUX_CFLAGS = "-O2 -mtune=cortex-a9 -mfpu=neon -mfloat-abi=hard"


KERNEL_HEADERS ?= YES

################################################################################
#
################################################################################

define GREET_MSG
##############################################################################
# Red Pitaya GNU/Linux Ecosystem
# Version: $(LINUX_VER)-$(REVISION)
# Build: $(BUILD_NUMBER)
# Branch: $(GIT_LOCAL_BRANCH)
# Commit: $(GIT_COMMIT)
# U-Boot: $(UBOOT_TAG)
# Linux Kernel: $(LINUX_TAG)
# SDR bundle: $(SDR_ZIP)
##############################################################################
endef
export GREET_MSG

################################################################################
# FPGA build provides: $(FSBL), $(FPGA).
################################################################################

# HWID=v1r0 - this value for 250-12 rev 1.0. In all other cases, this parameter is empty.

FPGA_COMMIT ?= unify/dev


HWID ?=
DEF_PARAM_BAREBONE ?=
DEF_PARAM_PYRPL ?= ALLOW_TIMING_FAIL
DEF_PARAM_STREAM_APP ?=
DEF_PARAM_LOGIC ?=
DEF_PARAM_V094 ?=

FPGA_PRJ ?=
FPGA_VERSION ?=
FPGA_MODEL ?=

# stream_app
FPGA_STREAM_APP=

# stream_app_250
FPGA_STREAM_APP_250=

# classic
FPGA_CLASSIC=

# logic
FPGA_LOGIC=

# logic_250
FPGA_LOGIC_250=

# v0.94
FPGA_0_94=

# v0.94_250
FPGA_0_94_250=

# mercury
FPGA_MERCURY=

# axi4lite
FPGA_AXI4LITE=

# barebone
FPGA_BAREBONE=

# pyrpl
FPGA_PYRPL=

# project fpga for build uboot
# Used with commit number or branch name
# FPGA_UBOOT=c822622082e63ce943c3b22e706e0c35dbe8d2f5
FPGA_UBOOT=$(FPGA_COMMIT)


ifeq ($(MODEL),Z10)

	# Used in board: stream_app classic logic v0.94 mercury axi4lite barebones

	FPGA_0_94	= $(FPGA_COMMIT)
	FPGA_BAREBONE = $(FPGA_COMMIT)
	FPGA_STREAM_APP = $(FPGA_COMMIT)
	FPGA_LOGIC	= $(FPGA_COMMIT)
	FPGA_PYRPL = $(FPGA_COMMIT)

	FPGA_MODEL = Z10
	FPGA_VERSION = z10_125
endif

ifeq ($(MODEL),Z20)

	# Used in board: v0.94 stream_app

	FPGA_0_94	= $(FPGA_COMMIT)
	FPGA_BAREBONE = $(FPGA_COMMIT)
	FPGA_STREAM_APP = $(FPGA_COMMIT)
	FPGA_LOGIC	= $(FPGA_COMMIT)

	FPGA_MODEL = Z20
	FPGA_VERSION = z20_122

endif

ifeq ($(MODEL),Z20_125)

	# Used in board: stream_app classic logic v0.94 mercury axi4lite

	FPGA_0_94	= $(FPGA_COMMIT)
	FPGA_BAREBONE = $(FPGA_COMMIT)
	FPGA_STREAM_APP = $(FPGA_COMMIT)
	FPGA_LOGIC	= $(FPGA_COMMIT)
	FPGA_PYRPL = $(FPGA_COMMIT)

	FPGA_MODEL = Z20_14
	FPGA_VERSION = z20_125

endif

ifeq ($(MODEL),Z20_125_4CH)

	# Used in board: v0.94

	FPGA_0_94	= $(FPGA_COMMIT)
	FPGA_BAREBONE = $(FPGA_COMMIT)
	FPGA_STREAM_APP = $(FPGA_COMMIT)
	FPGA_LOGIC	= $(FPGA_COMMIT)

	FPGA_MODEL = Z20_4
	FPGA_VERSION = z20_125_4ch

	DEF_PARAM_STREAM_APP = ALLOW_TIMING_FAIL

endif

ifeq ($(MODEL),Z20_250_12_1_0)

	# Used in board: stream_app_250 v0.94_250 logic_250

	FPGA_0_94	= $(FPGA_COMMIT)
	FPGA_BAREBONE = $(FPGA_COMMIT)
	FPGA_STREAM_APP = $(FPGA_COMMIT)
	FPGA_LOGIC	= $(FPGA_COMMIT)

	FPGA_MODEL = Z20_250
	FPGA_VERSION = z20_250_1_0
	HWID=v1r0

	DEF_PARAM_LOGIC = ALLOW_TIMING_FAIL
	DEF_PARAM_V094 = ALLOW_TIMING_FAIL
	DEF_PARAM_STREAM_APP = ALLOW_TIMING_FAIL

endif

ifeq ($(MODEL),Z20_250_12)

	# Used in board: stream_app_250 v0.94_250 logic_250

	FPGA_0_94	= $(FPGA_COMMIT)
	FPGA_BAREBONE = $(FPGA_COMMIT)
	FPGA_STREAM_APP = $(FPGA_COMMIT)
	FPGA_LOGIC	= $(FPGA_COMMIT)

	FPGA_MODEL = Z20_250
	FPGA_VERSION = z20_250

	DEF_PARAM_LOGIC = ALLOW_TIMING_FAIL
	DEF_PARAM_V094 = ALLOW_TIMING_FAIL
	DEF_PARAM_STREAM_APP = ALLOW_TIMING_FAIL

endif

ifeq ($(MODEL),Z20_250_12a)

	# Used FPGA bitstream from Z20_250_12 model
	# need rebuild only barebone for new dts

	FPGA_BAREBONE = $(FPGA_COMMIT)

	FPGA_MODEL = Z20_250
	FPGA_VERSION = z20_250a

endif


ifeq ($(MODEL),Z10_V2)

	# Used in board: v0.94 barebones

	FPGA_0_94	= $(FPGA_COMMIT)
	FPGA_BAREBONE = $(FPGA_COMMIT)
	FPGA_STREAM_APP = $(FPGA_COMMIT)
	FPGA_LOGIC	= $(FPGA_COMMIT)
	FPGA_PYRPL = $(FPGA_COMMIT)

	FPGA_MODEL = Z10
	FPGA_VERSION = z10_125_v2

endif

ifeq ($(MODEL),Z10_PRO_V2)

	# Used in board: v0.94 barebones

	FPGA_0_94	= $(FPGA_COMMIT)
	FPGA_BAREBONE = $(FPGA_COMMIT)
	FPGA_STREAM_APP = $(FPGA_COMMIT)
	FPGA_LOGIC	= $(FPGA_COMMIT)
	FPGA_PYRPL = $(FPGA_COMMIT)

	FPGA_MODEL = Z10
	FPGA_VERSION = z10_125_pro_v2

endif

ifeq ($(MODEL),Z20_125_V2)

	# Used in board: v0.94 barebones

	FPGA_0_94	= $(FPGA_COMMIT)
	FPGA_BAREBONE = $(FPGA_COMMIT)
	FPGA_STREAM_APP = $(FPGA_COMMIT)
	FPGA_LOGIC	= $(FPGA_COMMIT)
	FPGA_PYRPL = $(FPGA_COMMIT)

	FPGA_MODEL = Z20_G2
	FPGA_VERSION = z20_125_v2

endif

ifeq ($(MODEL),Z20_LL)

	# Used in board: v0.94 barebones

	FPGA_0_94	= $(FPGA_COMMIT)
	FPGA_BAREBONE = $(FPGA_COMMIT)

	FPGA_MODEL = Z20_ll
	FPGA_VERSION = z20_125_ll

#todo
#   FPGA_STREAM_APP = $(FPGA_COMMIT)
#	FPGA_LOGIC	= $(FPGA_COMMIT)

endif

.PHONY: fpga $(INSTALL_DIR)/fpga

fpga: $(INSTALL_DIR)/fpga


define build_fpga
	./download_fpga.sh $(FPGA_VERSION) $(1) $(GIT_MODE) $(5) $(GITLAB_TOKEN) build $(GIT_LOCAL_PATH)
	mkdir -p $(INSTALL_DIR)/fpga/$(FPGA_VERSION)/$(1)
	make -C fpga/build PRJ=$(1) MODEL=$(2) DEFINES=$(3) HWID=$(4) DTS_VER=2025.1 FPGA_VERSION=$(FPGA_VERSION)

	rm -rf fpga/$(FPGA_VERSION)/$(1)
	mkdir -p fpga/$(FPGA_VERSION)/$(1)
	mv fpga/build/* fpga/$(FPGA_VERSION)/$(1)

	cp    fpga/$(FPGA_VERSION)/$(1)/prj/$(1)/out/red_pitaya.bin       $(INSTALL_DIR)/fpga/$(FPGA_VERSION)/$(1)/fpga.bin
	cp    fpga/$(FPGA_VERSION)/$(1)/prj/$(1)/out/red_pitaya.bit       $(INSTALL_DIR)/fpga/$(FPGA_VERSION)/$(1)/fpga.bit
    cp -f fpga/$(FPGA_VERSION)/$(1)/git_info.txt                      $(INSTALL_DIR)/fpga/$(FPGA_VERSION)/$(1)/git_info.txt

endef

$(INSTALL_DIR)/fpga: $(DTREE_DIR)
	mkdir -p $(INSTALL_DIR)/fpga

ifneq "$(FPGA_BAREBONE)" ""
	$(call build_fpga,barebones,$(FPGA_MODEL),$(DEF_PARAM_BAREBONE),$(HWID),$(FPGA_BAREBONE))
	mkdir -p $(INSTALL_DIR)/dts/$(FPGA_VERSION)
	cp -f fpga/$(FPGA_VERSION)/barebones/prj/barebones/out/dts/dtraw.dtb  $(INSTALL_DIR)/dts/$(FPGA_VERSION)/devicetree.dtb
	cp -f fpga/$(FPGA_VERSION)/barebones/prj/barebones/out/dts/dtraw.dtbs  $(INSTALL_DIR)/dts/$(FPGA_VERSION)/dtraw.dts
	cp -f fpga/$(FPGA_VERSION)/barebones/prj/barebones/out/dts/led-system.dtbo $(INSTALL_DIR)/fpga/$(FPGA_VERSION)/barebones/led-system.dtbo
endif

ifneq "$(FPGA_PYRPL)" ""
	$(call build_fpga,pyrpl,$(FPGA_MODEL),$(DEF_PARAM_PYRPL),$(HWID),$(FPGA_PYRPL))
	cp -f fpga/$(FPGA_VERSION)/pyrpl/prj/pyrpl/out/fpga.dtbo  $(INSTALL_DIR)/fpga/$(FPGA_VERSION)/pyrpl/fpga.dtbo
	cp -f fpga/$(FPGA_VERSION)/pyrpl/prj/pyrpl/out/fpga.dtso  $(INSTALL_DIR)/fpga/$(FPGA_VERSION)/pyrpl/fpga.dtso
endif

ifneq "$(FPGA_STREAM_APP)" ""
	$(call build_fpga,stream_app,$(FPGA_MODEL),$(DEF_PARAM_STREAM_APP),$(HWID),$(FPGA_STREAM_APP))
	cp -f fpga/$(FPGA_VERSION)/stream_app/prj/stream_app/out/fpga.dtbo  $(INSTALL_DIR)/fpga/$(FPGA_VERSION)/stream_app/fpga.dtbo
	cp -f fpga/$(FPGA_VERSION)/stream_app/prj/stream_app/out/fpga.dtso  $(INSTALL_DIR)/fpga/$(FPGA_VERSION)/stream_app/fpga.dtso
endif

ifneq "$(FPGA_LOGIC)" ""
	$(call build_fpga,logic,$(FPGA_MODEL),$(DEF_PARAM_LOGIC),$(HWID),$(FPGA_LOGIC))
	cp -f fpga/$(FPGA_VERSION)/logic/prj/logic/out/fpga.dtbo  $(INSTALL_DIR)/fpga/$(FPGA_VERSION)/logic/fpga.dtbo
	cp -f fpga/$(FPGA_VERSION)/logic/prj/logic/out/fpga.dtso  $(INSTALL_DIR)/fpga/$(FPGA_VERSION)/logic/fpga.dtso
endif

ifneq "$(FPGA_0_94)" ""
	$(call build_fpga,v0.94,$(FPGA_MODEL),$(DEF_PARAM_V094),$(HWID),$(FPGA_0_94))
	cp -f fpga/$(FPGA_VERSION)/v0.94/prj/v0.94/out/fpga.dtbo  $(INSTALL_DIR)/fpga/$(FPGA_VERSION)/v0.94/fpga.dtbo
	cp -f fpga/$(FPGA_VERSION)/v0.94/prj/v0.94/out/fpga.dtso  $(INSTALL_DIR)/fpga/$(FPGA_VERSION)/v0.94/fpga.dtso
endif



################################################################################
# FSBL for uboot processing
################################################################################
#
# One FSBL serves every board. It reads hw_rev from the EEPROM before the DDR
# controller is configured and switches to the 32-bit bus on the models that
# carry a second DDR chip. The list of those models is generated from the board
# profiles, which are the only place the memory size is recorded.
#
# MODEL is not passed on: it selects the part number for the PL stub and has no
# effect on the PS initialisation the FSBL actually uses.

FSBL = $(TMP)/fsbl.elf
FSBL_DTS = $(TMP)/fsbl_dts.dtb

RAM_PROFILES = fpga/fsbl/prj/fsbl/src/rp_ram_profiles.h

.PHONY: fsbl_ub

fsbl_ub:
	echo $@
	./download_fpga.sh all fsbl $(GIT_MODE) $(FPGA_UBOOT) $(GITLAB_TOKEN) fsbl $(GIT_LOCAL_PATH)
	python3 build_scripts/gen_ram_profiles.py \
		--profiles-dir rp-api/api-hw-profiles/src \
		--out $(RAM_PROFILES) \
		--check-uboot-script patches/u-boot/u-boot.script
	make -C fpga/fsbl fsbl
	make -C fpga/fsbl fsbl_test
	cp  fpga/fsbl/prj/fsbl/out/fsbl.elf $(FSBL)
	cp  fpga/fsbl/prj/fsbl/out/devicetree_uboot.dtb $(FSBL_DTS)


################################################################################
# U-Boot build provides: $(UBOOT)
################################################################################

UBOOT           = $(TMP)/u-boot.elf

UBOOT_SCRIPT    		= $(INSTALL_DIR)/u-boot.scr

.PHONY: u-boot $(UBOOT_TAR) $(UBOOT_DIR) $(UBOOT)

u-boot: $(UBOOT) $(UBOOT_SCRIPT)

$(UBOOT_TAR): | $(DL)
	curl -L $(UBOOT_URL) -o $@

$(UBOOT_DIR): $(UBOOT_TAR)
	rm -rf $@
	mkdir -p $@
	tar -zxf $< --strip-components=1 --directory=$@

$(UBOOT): $(UBOOT_DIR) $(TMP) fsbl_ub
	make -C $< distclean
	make -C $< clean
	make -C $< mrproper
	mkdir -p $</arch/arm/dts/
	cp  $(FSBL_DTS) $</arch/arm/dts/red-pitaya.dtb
	make -C $< zynq_red_pitaya_defconfig -j $(shell grep -c ^processor /proc/cpuinfo) DEVICE_TREE="red-pitaya"
	make -C $< -j $(shell grep -c ^processor /proc/cpuinfo) DEVICE_TREE="red-pitaya"
	cp $(UBOOT_DIR)/u-boot.elf $@

$(UBOOT_SCRIPT): $(UBOOT) $(INSTALL_DIR)
	$(UBOOT_DIR)/tools/mkimage -A ARM -O linux -T script -C none -a 0 -e 0 -n "boot Debian" -d patches/u-boot/u-boot.script $(UBOOT_SCRIPT)

################################################################################
# boot file generator
################################################################################

BOOT = $(INSTALL_DIR)/boot.bin

.PHONY: boot

boot: u-boot fsbl_ub $(INSTALL_DIR)
	@echo the_ROM_image:{[bootloader] $(FSBL) $(UBOOT) } > tmp/boot_uboot.bif
	bootgen -image tmp/boot_uboot.bif -arch zynq -o $(BOOT) -w on -log



################################################################################
# Linux build provides: $(LINUX)
################################################################################

LINUX = $(LINUX_DIR)/arch/arm/boot/uImage

.PHONY: linux linux_scripts $(LINUX) $(LINUX_DIR)

linux: $(LINUX)

$(LINUX_TAR): | $(DL)
	curl -L $(LINUX_URL) -o $@

$(LINUX_DIR): $(LINUX_TAR)
	mkdir -p $@
	tar -zxf $< --strip-components=1 --directory=$@

linux_scripts: $(LINUX_DIR)
	make -C $(LINUX_DIR) clean
	make -C $(LINUX_DIR) mrproper
	make -C $(LINUX_DIR) ARCH=arm redpitaya_zynq_defconfig -j $(shell grep -c ^processor /proc/cpuinfo)
	make -C $(LINUX_DIR) olddefconfig
	make -C $(LINUX_DIR) scripts

$(LINUX): linux_scripts
	make -C $(LINUX_DIR) clean
	make -C $(LINUX_DIR) mrproper
	make -C $(LINUX_DIR) ARCH=arm redpitaya_zynq_defconfig -j $(shell grep -c ^processor /proc/cpuinfo)
	make -C $(LINUX_DIR) ARCH=arm CFLAGS=$(LINUX_CFLAGS) -j $(shell grep -c ^processor /proc/cpuinfo) UIMAGE_LOADADDR=0x8000 uImage
ifeq ($(KERNEL_HEADERS),YES)
	make -C $(LINUX_DIR) headers_install ARCH=arm INSTALL_HDR_PATH=$(abspath $(INSTALL_DIR))/include/linux
endif
	cp $(LINUX_DIR)/arch/arm/boot/uImage $(INSTALL_DIR)


################################################################################
# SDR
################################################################################


SDR_URL = https://downloads.redpitaya.com/hamlab/sdr-bundle/$(SDR_ZIP)

sdr: | $(DL)
	curl -L "$(SDR_URL)" -o "$(DL)/$(SDR_ZIP)" --progress-bar
	mkdir -p $(INSTALL_DIR)/www/apps
	unzip -o $(DL)/$(SDR_ZIP) -d $(INSTALL_DIR)/www/apps

################################################################################
# tarball
################################################################################

ZIPFILE=ecosystem-$(VERSION)-$(REVISION).zip
ZIP_FPGA_FILE=fpga-$(MODEL)-$(STREAMING)-$(VERSION)-$(REVISION).zip

zip: $(ZIPFILE)

$(ZIPFILE): sdr
	cp -r OS/filesystem/*  $(INSTALL_DIR)
	# create version file
	@echo "$$GREET_MSG" >  $(INSTALL_DIR)/version.txt
	# build zip file
	cd $(INSTALL_DIR); md5sum boot.bin u-boot.scr uImage >  md5.txt
	cd $(INSTALL_DIR); zip -r ../$(ZIPFILE) *

zip_fpga: $(ZIP_FPGA_FILE)

$(ZIP_FPGA_FILE):
	cd $(INSTALL_DIR); zip -r ../$(ZIP_FPGA_FILE) *

################################################################################
#
################################################################################

clean:
	-make -C $(LINUX_DIR) clean
	make -C fpga clean
	-make -C $(UBOOT_DIR) clean
	# todo, remove downloaded libraries and symlinks
	$(RM) $(INSTALL_DIR) -rf


################################################################################
#
################################################################################


gen_report_fpga:
	./gen_fpga_report.sh $(FPGA_VERSION) $(FPGA_VERSION).html FPGA

gen_report_kernel:
	./gen_fpga_report.sh KERNEL kernel.html KERNEL

gen_report_eco:
	./gen_fpga_report.sh ECO ecosystem.html ECO


################################################################################
# streaming_client
################################################################################

# ============================================
# Docker configuration
# ============================================

DOCKER_IMAGE ?= rp-qt673-x86-lin-win
DOCKER_IMAGE_CONSOLE ?= rp-streaming

DOCKER_RUN = docker run --rm \
	--user $(id -u):$(id -g) \
	-e BUILD_NUMBER=$(BUILD_NUMBER) \
	-v $(shell pwd):/workspace



APP_STREAMINGMANAGER_DIR = apps-tools/streaming_manager
streaming:  streaming_client streaming_client_win streaming_client_arm64

streaming_client:
	$(MAKE) -i -C $(APP_STREAMINGMANAGER_DIR) clean
	$(MAKE) -C $(APP_STREAMINGMANAGER_DIR) INSTALL_DIR=$(abspath $(INSTALL_DIR)) install_client

streaming_client_win:
	$(MAKE) -i -C $(APP_STREAMINGMANAGER_DIR) clean
	$(MAKE) -C $(APP_STREAMINGMANAGER_DIR) INSTALL_DIR=$(abspath $(INSTALL_DIR)) install_client_win

streaming_client_arm64:
	$(MAKE) -i -C $(APP_STREAMINGMANAGER_DIR) clean
	$(MAKE) -C $(APP_STREAMINGMANAGER_DIR) INSTALL_DIR=$(abspath $(INSTALL_DIR)) install_client_arm64

streaming_client_qt:
	$(MAKE) -i -C $(APP_STREAMINGMANAGER_DIR) clean
	$(MAKE) -C $(APP_STREAMINGMANAGER_DIR) INSTALL_DIR=$(abspath $(INSTALL_DIR)) install_client_qt

docker-streaming_client:
	$(DOCKER_RUN) $(DOCKER_IMAGE_CONSOLE) make -f Makefile.x86 streaming DOCKER_BUILD=ON

docker-streaming_client_qt:
	@echo "========================================"
	@echo "Building streaming_client_qt in Docker"
	@echo "Docker image: $(DOCKER_IMAGE)"
	@echo "JENKINS_BUILD: $(JENKINS_BUILD)"
	@echo "========================================"
	$(DOCKER_RUN) $(DOCKER_IMAGE) make -f Makefile.x86 streaming_client_qt QT_DIR=/opt/qt/6.7.3/gcc_64 QT_HOST_PATH=/opt/qt/6.7.3/gcc_64

docker-streaming_client_qt_win:
	@echo "========================================"
	@echo "Building streaming_client_qt in Docker"
	@echo "Docker image: $(DOCKER_IMAGE)"
	@echo "JENKINS_BUILD: $(JENKINS_BUILD)"
	@echo "========================================"
	$(DOCKER_RUN) $(DOCKER_IMAGE) make -f Makefile.x86 streaming_client_qt_win QT_DIR=/opt/qt/6.7.3/mingw_64 QT_HOST_PATH=$/opt/qt/6.7.3/gcc_64

streaming_client_qt_win:
	$(MAKE) -i -C $(APP_STREAMINGMANAGER_DIR) clean
	$(MAKE) -C $(APP_STREAMINGMANAGER_DIR) INSTALL_DIR=$(abspath $(INSTALL_DIR)) install_client_qt_win
